{
  "name": "events-agent",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "check:fast": "npm run -s typecheck && npm run -s lint",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run -s check:fast && npm run -s test && npm run -s build",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "scout": "tsx --env-file-if-exists=.env src/main.ts",
    "replay": "tsx src/main.ts --replay test/fixtures/replay-basic",
    "google:auth": "tsx --env-file-if-exists=.env src/google-auth.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@libsql/client": "^0.18.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
